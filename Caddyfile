{
    auto_https off
    admin off
}

:7860 {
    encode gzip

    @omc path /omc /omc/*
    handle @omc {
        reverse_proxy 127.0.0.1:8080 {
            header_up Host {host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }
    # Only public inference routes. Never proxy /v8/management or /v0/management.
    @models path /v1 /v1/* /v1beta /v1beta/* /v1alpha /v1alpha/*
    handle @models {
        reverse_proxy 127.0.0.1:8317 {
            flush_interval -1
        }
    }

    handle /healthz {
        respond "ok" 200
    }

    handle / {
        redir /omc/ 302
    }

    handle {
        respond "Not Found" 404
    }
}
